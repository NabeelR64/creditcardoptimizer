generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth schema
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  lastLogin     DateTime?

  accounts        Account[]
  sessions        Session[]
  creditCards     CreditCard[]
  recommendations Recommendation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application specific schema
model CreditCard {
  id            String   @id @default(cuid())
  userId        String
  issuer        String
  cardName      String
  annualFee     Float
  rewardProgram String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  benefits     Benefit[]
  offers       Offer[]
  transactions Transaction[]
}

model Benefit {
  id          String   @id @default(cuid())
  cardId      String
  benefitType String
  description String
  startDate   DateTime
  endDate     DateTime
  value       Float

  creditCard CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Offer {
  id             String   @id @default(cuid())
  cardId         String
  merchant       String
  offerDetails   String
  expirationDate DateTime

  creditCard CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Transaction {
  id       String   @id @default(cuid())
  cardId   String
  merchant String
  category String
  amount   Float
  date     DateTime

  creditCard CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id                 String   @id @default(cuid())
  userId             String
  recommendationText String
  estimatedValue     Float?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
